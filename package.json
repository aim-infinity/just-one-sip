{
  "name": "just-one-sip",
  "description": "Just One Sip \u2014 finish your water bottle in a bumpy auto-rickshaw ride. A one-touch mobile browser game.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs --port 8081",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "vite-node scripts/sweep.ts",
    "probe": "vite-node scripts/probe.ts"
  },
  "devDependencies": {
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
